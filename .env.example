# Copy this file to .env and fill in your key. Restart the server after changes.

# --- Sarvam AI (speech in, speech out, name transliteration, LLM) ---
SARVAM_API_KEY=
# Speech-to-text: codemix handles mixed speech like "Lakshmi ku 150 rupees udhaar"
STT_MODEL=saaras:v4
STT_MODE=codemix
# Leave empty to auto-detect the language. Or force one, e.g. ta-IN
STT_LANGUAGE_CODE=
# true = send the language picked in the app to speech-to-text
STT_USE_UI_LANGUAGE=false
# Spoken replies. If they fail, check model/speaker names in the Sarvam dashboard;
# the app falls back to the browser's own voice.
TTS_ENABLED=true
TTS_MODEL=bulbul:v3
TTS_SPEAKER=shubh

# --- LLM (OpenAI-compatible). Defaults to Sarvam's chat API with your Sarvam key. ---
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b
# Optional: a bigger model just for voice questions
QUERY_LLM_MODEL=
# Optional backup: another provider's key (set LLM_BASE_URL and LLM_MODEL to match)
LLM_API_KEY=
# Leave empty for fast "non-think" answers
LLM_REASONING_EFFORT=

# --- App ---
SHOP_NAME=Shanthi Stores
# hi-IN, kn-IN, ta-IN, te-IN or en-IN (can also be changed in the app)
MERCHANT_LANGUAGE=ta-IN
# Your https tunnel URL, used in payment links and the Join QR code
PUBLIC_BASE_URL=http://localhost:8000

# --- Messaging: simulator (default) or whatsapp ---
MESSAGING_CHANNEL=simulator
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=khata-saathi-verify
# Required with whatsapp: without it, incoming messages are rejected (anyone could fake them)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Payments: mock (default) or paytm (needs app/payments.py PaytmProvider filled in) ---
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-this-secret

# --- Guardrails ---
MAX_AMOUNT_RUPEES=50000
DEFAULT_DUE_DAYS=3
REMINDER_GAP_DAYS=2
MIN_HOURS_BETWEEN_REMINDERS=24
# Only send reminders inside these IST hours. Empty = any time.
# Demo "Move time forward" ignores this so evening demos still work.
QUIET_HOURS=9-20

# --- Access ---
# This computer never needs a key. Other devices (the https tunnel, a phone) open the app once as
# <your address>/?key=<MERCHANT_KEY>. Leave empty and a new key is printed at each start.
MERCHANT_KEY=
# --- Runtime ---
SCHEDULER_ENABLED=true
DEMO_MODE=true
